page = PAGE
page {

    meta{
        viewport = width=device-width, initial-scale=1.0
        description = Kuratierte Handwerk-Abende für Anfänger in Baden-Württemberg. Töpfern, Holz, Lederwerk, Druck und mehr. Du nimmst dein Werk mit nach Hause.
        }

    headerData{
        10 = TEXT
        10.value (
           <link href="{path:EXT:filtgenmaster/Resources/Public/assets/icon-hell.svg}" rel="icon">
        )
        10.insertData = 1

    }
    includeCSS{
        landing = EXT:filtgenmaster/Resources/Public/styles/landing.css
    }

    includeJSFooter{
        site = EXT:filtgenmaster/Resources/Public/scripts/site.js
        page = EXT:filtgenmaster/Resources/Public/scripts/page-landing.js
    }

    10 = PAGEVIEW
    10 {
        paths{
            100 = EXT:filtgenmaster/Resources/Private/Templates/
        }

        variables{
            content0 = CONTENT
            content0 {
                table = tt_content
                select {
                    where = {#colPos} = 0
                    orderBy = sorting
                }
            }
            content1 < .content0
            content1.select.where = {#colPos} = 1
   
        }
        
    
}